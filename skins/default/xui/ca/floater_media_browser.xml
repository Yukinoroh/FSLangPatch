		<layout_panel name="nav_controls">
			<button label="Enrere" name="back" />
			<button label="Endavant" name="forward" />
			<button label="Actualitza" name="reload" />
			<button label="Vés" name="go" />
		</layout_panel>
		<layout_panel name="time_controls">
			<button label="rebobina" name="rewind" />
