<?xml version='1.0' encoding='utf-8'?>
<floater name="floatermedialists" title="Llistes de mèdia">
	<floater.string name="EnterUrlAllow">
		Introduïu el domini o l'URL per permetre sempre:
	</floater.string>
	<floater.string name="EnterUrlDeny">
		Introduïu el domini o l'URL per no permetre mai:
	</floater.string>
	<layout_stack name="lists_layout_stack">
		<layout_panel name="whitelist_layout_panel">
			<text name="whitelist_text">
		Dominis permesos:
	</text>
			<scroll_list name="whitelist">
				<column label="Llista blanca" name="list" width="315" />
			</scroll_list>
			<layout_stack name="whitelist_buttons_layout_stack">
				<layout_panel name="whitelist_buttons_panel_add">
					<button label="Afegeix..." label_selected="Afegeix..." name="add_whitelist" />
				</layout_panel>
				<layout_panel name="whitelist_buttons_panel_remove">
					<button label="Treu" name="remove_whitelist" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="blacklist_layout_panel">
			<text name="blacklist_text">
		Dominis blocats:
	</text>
			<scroll_list name="blacklist">
				<column label="Llista negra" name="list" />
			</scroll_list>
			<layout_stack name="blacklist_buttons_layout_stack">
				<layout_panel name="blacklist_buttons_panel_add">
					<button label="Afegeix..." label_selected="Afegeix..." name="add_blacklist" />
				</layout_panel>
				<layout_panel name="blacklist_buttons_panel_remove">
					<button label="Treu" label_selected="Treu" name="remove_blacklist" />
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</floater>