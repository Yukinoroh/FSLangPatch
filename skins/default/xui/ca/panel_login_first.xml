<?xml version='1.0' encoding='utf-8'?>
<panel name="panel_login">
	<panel.string name="forgot_password_url">http://secondlife.com/account/request.php?lang=fr</panel.string>
	<panel.string name="sign_up_url">https://join.secondlife.com/</panel.string>
	<layout_stack name="logo_stack">
		<layout_panel name="parent_panel2">
			<layout_stack name="widget_stack">
				<layout_panel name="widget_container">
					<combo_box label="Usuari" tool_tip="El nom d'usuari que vau triar en registrar-vos, per exemple: joanpi12 o Brillantor Estel·lar" name="username_combo" />
					<line_editor name="password_edit" label="Contrasenya" />
					<button label="Inicia la sessió" name="connect_btn" />
					<check_box font="SansSerifSmall" label="Recordeu la meva informació" name="remember_check" />
					<text name="forgot_password_text">Has oblidat la contrasenya?</text>
					<text name="sign_up_text">Registra't</text>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="parent_panel3">
			<layout_stack name="images_stack">
				<layout_panel name="images_container">
					<text name="image_caption_left">La teva primera parada és Learning Island. Trobeu el portal de sortida.</text>
					<text name="image_caption_right">A continuació, explora Social Island i coneix altres residents.</text>
				</layout_panel>
			</layout_stack>
		</layout_panel>
	</layout_stack>
</panel>