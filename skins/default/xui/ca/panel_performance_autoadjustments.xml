<?xml version='1.0' encoding='utf-8'?>
<panel bevel_style="none" follows="left|top" height="580" width="580" name="panel_performance_autoadjustments" layout="topleft" left="0" top="0">
	<button height="16" width="16" layout="topleft" mouse_opaque="true" follows="left|top" name="back_btn" top="7" image_selected="Arrow_Left_Off" image_pressed="Arrow_Left_Off" image_unselected="Arrow_Left_Off" left="15" is_toggle="true" />
	<text follows="left|top" height="18" layout="topleft" left_pad="0" valign="center" halign="center" top="6" name="back_lbl" width="32">
		Enrere
	</text>
	<text follows="left|top" font="SansSerifLarge" text_color="white" height="20" layout="topleft" left="20" top_pad="15" name="settings_title" width="600">
		Configuració d'ajust automàtic
	</text>
	<button follows="top|left" height="23" label="Restableix la configuració recomanada" layout="topleft" left_pad="20" name="recommended_btn" top_delta="-3" width="220" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left="20" top_pad="10" name="autotune_desc" width="580">
		Ajusta automàticament la distància de dibuixat per mantenir el rendiment.
	</text>
	<check_box follows="left|top" height="20" label="Ajusta automàticament la distància de dibuixat" layout="topleft" name="fas_check" top_pad="10" left="20" width="150" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" name="target_fps_lbl" top_pad="10" left="20" width="120">
		Taxa de fotogrames desitjada
	</text>
	<spinner control_name="AutoTuneFPS" height="20" layout="topleft" left_pad="15" follows="top|left" name="target_fps" width="60" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left_pad="10" name="fps_lbl" width="70">
		fps
	</text>
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" top_pad="10" name="avg_fps_lbl" width="120">
		Taxa mitjana de fotogrames
	</text>
	<spinner control_name="AutoTuneHistory" height="20" layout="topleft" left_pad="15" follows="top|left" name="avg_fps" width="60" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left_pad="10" name="seconds_lbl" width="70">
		segons
	</text>
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" top_pad="10" name="bandwidth_lbl" width="120">
		Llindar d'amplada de banda
	</text>
	<spinner control_name="AutoTuneBandwidth" height="20" layout="topleft" left_pad="15" follows="top|left" name="bandwidth" width="60" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left_pad="10" name="kbps_lbl" width="70">
		kbps
	</text>
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" top_pad="10" name="draw_dist_lbl" width="120">
		Taxa de canvi de la distància de dibuixat
	</text>
	<spinner control_name="AutoTuneDrawDistance" height="20" layout="topleft" left_pad="15" follows="top|left" name="draw_dist" max_val="256" width="60" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left_pad="10" name="dist_meters" width="70">
		metres
	</text>
	<view_border bevel_style="in" height="0" layout="topleft" name="border2" top_pad="20" left="20" width="540" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left="20" top_pad="15" name="dist_limits_desc" width="580">
		Tria el rang de distància que afectarà la configuració automàtica.
	</text>
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" top_pad="15" name="min_dist_lbl" width="120">
		Distància mínima
	</text>
	<spinner control_name="AutoTuneRenderFarClipMin" height="20" layout="topleft" left_pad="15" follows="top|left" name="min_dist" width="60" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left_pad="10" name="min_meters" width="70">
		metres
	</text>
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" top_pad="15" name="max_dist_lbl" width="120">
		Distància màxima
	</text>
	<spinner control_name="AutoTuneRenderFarClipMax" height="20" layout="topleft" left_pad="15" follows="top|left" name="max_dist" width="60" />
	<text follows="left|top" font="SansSerifSmall" text_color="White" height="18" layout="topleft" left_pad="10" name="max_meters" width="70">
		metres
	</text>
</panel>